APP_ENV=development
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<your-neon-host>/<db_name>?sslmode=require
JWT_SECRET_KEY=replace-this-secret
JWT_ALGORITHM=HS256

# Admin Credentials (used by seed script)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# Email OTP Authentication
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS_PER_HOUR=5
OTP_DEV_MODE=true

# SMTP (optional; if not configured, OTP is logged on server in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Pinecone (for AI analyst RAG memory)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=saree-business-memory
PINECONE_NAMESPACE=admin-analytics
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

